{

  "version": 2,

  "builds": [

    {

      "src": "api/index.ts",

      "use": "@vercel/node"

    },

    {

      "src": "package.json",

      "use": "@vercel/static-build",

      "config": {

        "distDir": "dist"

      }

    }

  ],

  "routes": [

    {

      "src": "/api/(.*)",

      "dest": "/api/index.ts"

    },

    {

      "src": "/robots.txt",

      "dest": "/robots.txt"

    },

    {

      "src": "/sitemap.xml",

      "dest": "/sitemap.xml"

    },

    {

      "src": "/favicon.svg",

      "dest": "/favicon.svg"

    },

    {

      "src": "/googlea3b82a96ec7a037f.html",

      "dest": "/googlea3b82a96ec7a037f.html"

    },

    {

      "src": "/assets/(.*)",

      "dest": "/assets/$1",

      "headers": {

        "Cache-Control": "public, max-age=31536000, immutable"

      }

    },

    {

      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|mp4|webm))",

      "dest": "/$1",

      "headers": {

        "Cache-Control": "public, max-age=31536000, immutable"

      }

    },

    {

      "src": "/videos/(.*)",

      "dest": "/videos/$1",

      "headers": {

        "Cache-Control": "public, max-age=31536000, immutable",

        "Content-Type": "video/mp4"

      }

    },

    {

      "src": "/all-tools",

      "dest": "/all-tools/index.html"

    },

    {

      "src": "/resume-builder",

      "dest": "/resume-builder/index.html"

    },

    {

      "src": "/ats-resume-checker",

      "dest": "/ats-resume-checker/index.html"

    },

    {

      "src": "/cover-letter-generator",

      "dest": "/cover-letter-generator/index.html"

    },

    {

      "src": "/job-tracker",

      "dest": "/job-tracker/index.html"

    },

    {

      "src": "/interview-prep",

      "dest": "/interview-prep/index.html"

    },

    {

      "src": "/pdf-converter",

      "dest": "/pdf-converter/index.html"

    },

    {

      "src": "/ai-assistant",

      "dest": "/ai-assistant/index.html"

    },

    {

      "src": "/ai-caption-generator",

      "dest": "/ai-caption-generator/index.html"

    },

    {

      "src": "/youtube-title-generator",

      "dest": "/youtube-title-generator/index.html"

    },

    {

      "src": "/age-calculator",

      "dest": "/age-calculator/index.html"

    },

    {

      "src": "/gpa-calculator",

      "dest": "/gpa-calculator/index.html"

    },

    {

      "src": "/contact",

      "dest": "/contact/index.html"

    },

    {

      "src": "/profile",

      "dest": "/profile/index.html"

    },

    {

      "src": "/(.*)",

      "dest": "/index.html"

    }

  ]

}

