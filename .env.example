# MISTRAL_API_KEY: Required for Mistral AI API calls.
# For development (local): Use VITE_ prefix (Vite requirement)
# For production: Use plain name (server-side)
VITE_MISTRAL_API_KEY="YOUR_MISTRAL_API_KEY"
# Alternative for production deployment:
# MISTRAL_API_KEY="YOUR_MISTRAL_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# VITE_GA_ID: Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Configure this for Vercel deployment to enable Google Analytics tracking
# Vite automatically exposes variables with VITE_ prefix to the client
VITE_GA_ID="G-YOUR_GA_MEASUREMENT_ID"

# EmailJS configuration for contact form
# Get these values from https://www.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"
VITE_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="YOUR_EMAILJS_TEMPLATE_ID"

# Firebase configuration
# Get these values from your Firebase project settings
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
